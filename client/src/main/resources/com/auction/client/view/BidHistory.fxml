<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="820.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.BidHistoryController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="navbar">
            <children>
                <Label styleClass="nav-logo-text" text="AUCTION PRO" />
                <HBox HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="40">
                    <children>
                        <Label fx:id="navAuctions" onMouseClicked="#handleNavAuctions" style="-fx-cursor: hand;" styleClass="nav-link" text="AUCTIONS" />
                        <Label fx:id="navHistory" onMouseClicked="#handleNavHistory" style="-fx-text-fill: #f0b429; -fx-cursor: hand;" styleClass="nav-link" text="HISTORY" />
                    </children>
                </HBox>
                <HBox HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="16">
                    <children>
                        <TextField prefWidth="280" promptText="Search activities..." styleClass="search-field" />
                        <Button onAction="#handleLogout" style="-fx-background-color:rgba(239,68,68,0.1); -fx-text-fill:#ef4444; -fx-font-size:11px; -fx-font-family:'Arial'; -fx-border-color:rgba(239,68,68,0.3); -fx-border-radius:20; -fx-background-radius:20; -fx-padding:5 14; -fx-cursor:hand;" text="Logout" />
                        <StackPane>
                            <children>
                                <Circle radius="18" style="-fx-fill: #1e1c15; -fx-stroke: #f0b429; -fx-stroke-width: 2;" />
                                <Label style="-fx-text-fill: #f0b429; -fx-font-weight: bold; -fx-font-size: 14px;" text="A" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="35.0" style="-fx-padding: 35 40;">
            <children>

                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-text-fill: #f5f0e6; -fx-font-size: 20px; -fx-font-weight: bold;" text="Account Activity &amp; Bid History" />
                                <Label style="-fx-text-fill: #8a8272; -fx-font-size: 13px;" text="Audited record of active bids, winning placements, and transaction logs." />
                            </children>
                        </VBox>

                        <ListView fx:id="activityListView" style="-fx-background-color: #1e1c15; -fx-border-color: #2d2a22; -fx-background-insets: 0; -fx-border-radius: 12; -fx-background-radius: 12;" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
