<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="820" prefWidth="1280" styleClass="al-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminDashboardController">

    <!-- ═══════════ NAVBAR ═══════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="54" spacing="0" styleClass="al-navbar">
            <Label styleClass="nav-logo-text" text="AUCTION PRO">
                <HBox.margin><Insets right="32" /></HBox.margin>
            </Label>
            <Label style="-fx-text-fill:#ef4444; -fx-font-size:11px; -fx-font-weight:bold;                           -fx-font-family:'Arial'; -fx-background-color:rgba(239,68,68,0.12);                           -fx-border-color:rgba(239,68,68,0.4); -fx-border-radius:20;                           -fx-background-radius:20; -fx-padding:3 12;" text="ADMIN PANEL">
                <HBox.margin><Insets right="24" /></HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="14">
                <Button style="-fx-background-color:#141929; -fx-text-fill:#9aa0b4;                                -fx-font-size:15px; -fx-background-radius:20;                                -fx-border-color:rgba(201,168,76,0.2); -fx-border-radius:20;                                -fx-border-width:1; -fx-padding:6 10; -fx-cursor:hand;" text="🔔" />
                <StackPane>
                    <Circle radius="18" style="-fx-fill:#2a0a0a; -fx-stroke:#ef4444; -fx-stroke-width:2;" />
                    <Label style="-fx-text-fill:#ef4444; -fx-font-size:14px; -fx-font-weight:bold;" text="A" />
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════ CENTER ═══════════ -->
    <center>
        <HBox>

            <!-- ── SIDEBAR ── -->
            <VBox prefWidth="230" spacing="0" styleClass="al-sidebar">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane>
                        <Circle radius="22" style="-fx-fill:#2a0a0a; -fx-stroke:#ef4444; -fx-stroke-width:2;" />
                        <Label style="-fx-text-fill:#ef4444; -fx-font-size:16px; -fx-font-weight:bold;" text="A" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="al-user-name" text="Admin" />
                        <Label style="-fx-text-fill:#ef4444; -fx-font-size:9px; -fx-font-weight:bold;" text="SUPER ADMINISTRATOR" />
                    </VBox>
                    <VBox.margin><Insets bottom="24" /></VBox.margin>
                </HBox>

                <Button fx:id="sideOverview" maxWidth="Infinity" styleClass="al-nav-item-active" text="📊  Overview"><VBox.margin><Insets bottom="4" /></VBox.margin></Button>
                <Button fx:id="sideUsers" maxWidth="Infinity" styleClass="al-nav-item" text="👥  Users"><VBox.margin><Insets bottom="4" /></VBox.margin></Button>
                <Button fx:id="sideAuctions" maxWidth="Infinity" styleClass="al-nav-item" text="🔨  Auctions"><VBox.margin><Insets bottom="4" /></VBox.margin></Button>
                <Button fx:id="sideApprovals" maxWidth="Infinity" styleClass="al-nav-item" text="✅  Approvals"><VBox.margin><Insets bottom="4" /></VBox.margin></Button>

                <Separator style="-fx-background-color:rgba(201,168,76,0.1);"><VBox.margin><Insets bottom="20" /></VBox.margin></Separator>

                <VBox VBox.vgrow="ALWAYS" />

                <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="36" style="-fx-background-color:rgba(239,68,68,0.1); -fx-text-fill:#ef4444;                                -fx-font-size:12px; -fx-font-family:'Arial';                                -fx-border-color:rgba(239,68,68,0.3); -fx-border-radius:6;                                -fx-background-radius:6; -fx-cursor:hand;" text="🚪  Logout">
                    <VBox.margin><Insets top="24" /></VBox.margin>
                </Button>
            </VBox>

            <!-- ── MAIN ── -->
            <VBox spacing="0" styleClass="al-content" HBox.hgrow="ALWAYS">

                <!-- Title -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="al-page-title" text="Admin Dashboard" />
                        <Label styleClass="al-page-subtitle" text="Admin overview — users, auctions, revenue and approvals." />
                    </VBox>
                    <Label fx:id="serverTimeLabel" style="-fx-text-fill:#555e7a; -fx-font-size:11px; -fx-font-family:'monospace';" text="Server: 00:00:00 UTC" />
                    <VBox.margin><Insets bottom="24" /></VBox.margin>
                </HBox>

                <!-- Stat cards (2x2) -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25" />
                    </columnConstraints>

                    <VBox spacing="8" styleClass="sd-stat-card" GridPane.columnIndex="0">
                        <Label styleClass="sd-stat-label" text="TOTAL USERS" />
                        <Label fx:id="cardUsers" styleClass="sd-stat-value" text="1,284" />
                        <Label style="-fx-text-fill:#4ade80; -fx-font-size:11px; -fx-font-family:'Arial';" text="Users" />
                    </VBox>
                    <VBox spacing="8" styleClass="sd-stat-card" GridPane.columnIndex="1">
                        <Label styleClass="sd-stat-label" text="LIVE AUCTIONS" />
                        <Label fx:id="cardAuctions" styleClass="sd-stat-value" text="47" />
                        <Label style="-fx-text-fill:#f59e0b; -fx-font-size:11px; -fx-font-family:'Arial';" text="LIVE" />
                    </VBox>
                    <VBox spacing="8" styleClass="sd-stat-card" GridPane.columnIndex="2">
                        <Label styleClass="sd-stat-label" text="PLATFORM REVENUE" />
                        <Label fx:id="cardRevenue" styleClass="sd-stat-value-gold" text="\$2.4M" />
                        <Label style="-fx-text-fill:#4ade80; -fx-font-size:11px; -fx-font-family:'Arial';" text="This month" />
                    </VBox>
                    <VBox spacing="8" styleClass="sd-stat-card" GridPane.columnIndex="3">
                        <Label styleClass="sd-stat-label" text="PENDING APPROVAL" />
                        <Label fx:id="cardPending" styleClass="sd-stat-value-red" text="9" />
                        <Label style="-fx-text-fill:#ef4444; -fx-font-size:11px; -fx-font-family:'Arial';" text="Needs review" />
                    </VBox>
                    <GridPane.margin><Insets bottom="24" /></GridPane.margin>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <!-- Tabs -->
                <TabPane fx:id="tabPane" styleClass="sd-tab-pane" VBox.vgrow="ALWAYS">

                    <!-- Tab: Users -->
                    <Tab closable="false" text="Users">
                        <VBox spacing="14" style="-fx-padding:16 0 0 0;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <TextField fx:id="searchUsers" prefHeight="34" prefWidth="240" promptText="Search users..." style="-fx-padding:8 14 8 14;" styleClass="al-search-field" />
                                <ComboBox fx:id="filterRole" prefHeight="34" prefWidth="140" styleClass="al-sort-combo" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleExportUsers" style="-fx-background-color:rgba(201,168,76,0.12);                                                -fx-text-fill:#c9a84c; -fx-font-size:12px;                                                -fx-border-color:rgba(201,168,76,0.3);                                                -fx-border-radius:6; -fx-background-radius:6;                                                -fx-padding:8 16; -fx-cursor:hand;" text="Export CSV" />
                            </HBox>
                            <TableView fx:id="usersTable" styleClass="sd-table" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colUserId" prefWidth="60" text="ID" />
                                    <TableColumn fx:id="colUserName" prefWidth="160" text="Name" />
                                    <TableColumn fx:id="colUserEmail" prefWidth="200" text="Email" />
                                    <TableColumn fx:id="colUserRole" prefWidth="100" text="Role" />
                                    <TableColumn fx:id="colUserStatus" prefWidth="100" text="Status" />
                                    <TableColumn fx:id="colUserJoined" prefWidth="120" text="Joined" />
                                    <TableColumn fx:id="colUserAction" prefWidth="120" text="Actions" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Tab: Auctions -->
                    <Tab closable="false" text="Auctions">
                        <VBox spacing="14" style="-fx-padding:16 0 0 0;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <TextField fx:id="searchAuctions" prefHeight="34" prefWidth="240" promptText="Search auctions..." style="-fx-padding:8 14 8 14;" styleClass="al-search-field" />
                                <ComboBox fx:id="filterAuctionStatus" prefHeight="34" prefWidth="150" styleClass="al-sort-combo" />
                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>
                            <TableView fx:id="auctionsTable" styleClass="sd-table" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colAucId" prefWidth="60" text="ID" />
                                    <TableColumn fx:id="colAucTitle" prefWidth="200" text="Item" />
                                    <TableColumn fx:id="colAucSeller" prefWidth="140" text="Seller" />
                                    <TableColumn fx:id="colAucBid" prefWidth="120" text="Current Bid" />
                                    <TableColumn fx:id="colAucBids" prefWidth="70" text="Bids" />
                                    <TableColumn fx:id="colAucStatus" prefWidth="100" text="Status" />
                                    <TableColumn fx:id="colAucAction" prefWidth="120" text="Actions" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Tab: Approvals -->
                    <Tab closable="false" text="Approvals">
                        <VBox spacing="14" style="-fx-padding:16 0 0 0;">
                            <TableView fx:id="approvalsTable" styleClass="sd-table" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colAppItem" prefWidth="220" text="Item" />
                                    <TableColumn fx:id="colAppSeller" prefWidth="150" text="Seller" />
                                    <TableColumn fx:id="colAppCategory" prefWidth="120" text="Category" />
                                    <TableColumn fx:id="colAppPrice" prefWidth="120" text="Start Price" />
                                    <TableColumn fx:id="colAppDate" prefWidth="130" text="Submitted" />
                                    <TableColumn fx:id="colAppAction" prefWidth="160" text="Action" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
